---
import Team from '../components/films/Team.astro';
import Heading from '../components/films/Heading.astro';
import EntriesCards from '../components/films/EntriesCards.astro';
import Layout from '../../layouts/Layout.astro';
import { useI18n } from '../../utils/i18n';
import { languages, defaultLanguage } from '../../i18n/config';

export function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;
if (!languages.includes(lang)) {
  return Astro.redirect(`/${defaultLanguage}`);
}

const i18n = useI18n(lang);
const translations = {
  "page.films": {
    "title": "La Jetée Films | Films",
    "description": "Explorez notre collection de films documentaires qui capturent les voix silenciées. Chaque film est un témoignage, chaque image un acte de résilience."
  }
};
---

<Layout
description={i18n.t('page.films.description')}
title={i18n.t('page.films.title')}
>
  <Heading />
  <EntriesCards />
  <Team />
</Layout>
