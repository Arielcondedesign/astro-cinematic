---
import Layout from '../../layouts/Layout.astro';
import { useI18n } from '../../utils/i18n';
import { languages, defaultLanguage } from '../../i18n/config';

export function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;
if (!languages.includes(lang)) {
  return Astro.redirect(`/${defaultLanguage}`);
}

const i18n = useI18n(lang);
const translations = {
  "page.confidentialite": {
    "title": "La Jetée Films | Confidentialité",
    "description": "La Jetée Films : Engagement de protection des données personnelles. Transparence sur la collecte, l'utilisation et la sécurité de vos informations."
  }
};
---

<Layout
  description={i18n.t('page.confidentialite.description')}
  title={i18n.t('page.confidentialite.title')}
>
<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="sm:pb:20 flex flex-col gap-4 pb-16 text-center">
    <h1 class="text-4xl font-medium tracking-tight sm:text-5xl">{i18n.t('page.confidentialite.title')}</h1>
    <p class="text-base">{i18n.t('page.confidentialite.lastUpdate')}</p>
  </div>
  <div>
    <p class="mb-4">
      {i18n.t('page.confidentialite.description')}
    </p>
    
    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">{i18n.t('page.confidentialite.informationsCollectees')}</h2>
    <p class="mb-6">
      {i18n.t('page.confidentialite.nousPouvonsCollecter')}
    </p>
    <ul class="list-inside list-disc space-y-4">
      <li>
        {i18n.t('page.confidentialite.informationsQueVousNousTransmettez')} : {i18n.t('page.confidentialite.lorsDeVotreInscriptionOuUtilisationDeNosServices')}
        coordonnées de contact et autres informations pertinentes.
      </li>
      <li>
        {i18n.t('page.confidentialite.donneesDutilisation')} : {i18n.t('page.confidentialite.nousCollectonsDesInformationsSurVotreUtilisationDeNosServices')}
        {i18n.t('page.confidentialite.incluantVotreAdresseIPTypeDeNavigateurInformations')}
        sur l'appareil, pages visitées et interactions avec le contenu.
      </li>
      <li>
        {i18n.t('page.confidentialite.cookiesEtTechnologiesSimilaires')} : {i18n.t('page.confidentialite.nousUtilisonsDesCookiesPourAmeliorer')}
        {i18n.t('page.confidentialite.votreExperienceComprendreVosHabitudesDutilisationEtOptimiserNosServices')}
      </li>
    </ul>
    
    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">2. Utilisation de Vos Informations</h2>
    <p class="mb-4">{i18n.t('page.confidentialite.nousUtilisonsVosDonneesPersonnellesDansLesObjectifsSuivants')}</p>
    <ul class="list-inside list-disc space-y-4">
      <li>
        {i18n.t('page.confidentialite.fournirEtAmeliorerNosServices')} : {i18n.t('page.confidentialite.vosInformationsNousAidentAOffrirUneExperiencePersonnaliseeEtConviviale')}
      </li>
      <li>
        {i18n.t('page.confidentialite.communication')} : {i18n.t('page.confidentialite.nousPouvonsUtiliserVotreAdresseElectroniquePourVousEnvoyerDesMisesAJourImportantesNewslettersEtContenusPromotionnels')}
        Vous pouvez vous désinscrire de ces communications à tout moment.
      </li>
      <li>
        {i18n.t('page.confidentialite.analyse')} : {i18n.t('page.confidentialite.nousUtilisonsDesDonneesAgregeesEtAnonymiseesPourAnalyserLeComportementDesUtilisateursEtAmeliorerNosServices')}
      </li>
    </ul>

    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">3. Vos Droits</h2>
    <p class="mb-4">
      {i18n.t('page.confidentialite.conformementAuReglementGeneraleSurLaProtectionDesDonneesRGPDVousDisposesDesDroitsSuivants')}
    </p>
    <ul class="list-inside list-disc space-y-4">
      <li>{i18n.t('page.confidentialite.droitDAcces')} : {i18n.t('page.confidentialite.vousAvezLeDroitDaccederAuxInformationsPersonnellesQueNousCollectons')}</li>
      <li>{i18n.t('page.confidentialite.droitDeRectification')} : {i18n.t('page.confidentialite.vousAvezLeDroitDeRectifierLesInformationsPersonnellesQueVousSouhaitezCorriger')}</li>
      <li>{i18n.t('page.confidentialite.droitAEffacement')} : {i18n.t('page.confidentialite.vousAvezLeDroitDeSupprimerLesInformationsPersonnellesQueVousSouhaitezEffacer')}</li>
      <li>{i18n.t('page.confidentialite.droitALimitationDuTraitement')} : {i18n.t('page.confidentialite.vousAvezLeDroitDeLimitationDuTraitementDesInformationsPersonnelles')}</li>
      <li>{i18n.t('page.confidentialite.droitDePortabilite')} : {i18n.t('page.confidentialite.vousAvezLeDroitDeTransmettreVosInformationsPersonnellesAUnAutreService')}</li>
      <li>{i18n.t('page.confidentialite.droitDopposition')} : {i18n.t('page.confidentialite.vousAvezLeDroitDeNePasRecevoirDeNouvellesInformationsPersonnelles')}</li>
    </ul>

    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">Nous Contacter</h2>
    <p class="mb-4">
      {i18n.t('page.confidentialite.pourTouteQuestionOuPreoccupationConcernantNotrePolitiqueDeConfidentialiteVousPouvezNousContacter')}
    </p>
    <ul class="list-inside list-disc space-y-4">
      <li>Email : lajeteefilms@gmail.com</li>
      <li>Téléphone : +33 624 43 50 03</li>
      <li>Adresse : Toulouse, France</li>
    </ul>

    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">Consentement</h2>
    <p class="mb-4">
      {i18n.t('page.confidentialite.enUtilisantNosServicesVousConsiderezCommeConsentementA')}
      {i18n.t('page.confidentialite.nousNousEngagonsAProtégerVosDonneesPersonnellesEtARespecterVosDroitsConformementALegislationEnVigueur')}
    </p>
  </div>
</div>
</Layout>
