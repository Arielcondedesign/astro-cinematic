---
import Hero from '../../components/home/Hero.astro';
import About from '../../components/home/About.astro';
import Gallery from '../../components/home/Gallery.astro';
import Services from '../../components/home/Services.astro';
import Cta from '../../components/home/Cta.astro';
import Layout from '../../layouts/Layout.astro';
import { useI18n } from '../../utils/i18n';
import { languages, defaultLanguage } from '../../i18n/config';

export function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;
if (!languages.includes(lang)) {
  return Astro.redirect(`/${defaultLanguage}`);
}

const i18n = useI18n(lang);
const translations = {
  "page.home": {
    "title": "La Jetée Films | Accueil",
    "description": "Bienvenue sur la page d'accueil de La Jetée Films, un studio de production cinématographique specialisé dans la production de films documentaires et de courts-métages. Nous sommes fiers de vous offrir une gamme de services de haute qualité, alliant expertise, innovation et respect pour chaque projet."
  }
};
---

<Layout
description={i18n.t('page.home.description')}
title={i18n.t('page.home.title')}
>
  <Hero />
  <About />
  <Gallery />
  <Services />
  <Cta />
</Layout>