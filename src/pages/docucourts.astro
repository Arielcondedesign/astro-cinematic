---
import Heading from '../components/courts/Heading.astro';
import Projects from '../components/courts/Projects.astro';
import Layout from '../layouts/Layout.astro';
import { useTranslations } from "../i18n/utils";
import { languageList } from "../i18n/ui";

const currentLang = Astro.currentLocale || "fr";
const t = useTranslations(currentLang as keyof typeof languageList);
---

<Layout title={t("courts.title.tag")} description={t("courts.meta.description")}>
<Heading />
<Projects />
</Layout>
