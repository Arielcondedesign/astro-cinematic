---
import Layout from '../../layouts/Layout.astro';

import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";

const currentLang = Astro.currentLocale || "en";
const t = useTranslations(currentLang as keyof typeof languageList);
---

<Layout title={t("legal.title.tag")} description={t("legal.meta.description")}>
<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="sm:pb:20 flex flex-col gap-4 pb-16 text-center">
    <h1 class="text-4xl font-medium tracking-tight sm:text-5xl">{t("legal.h1")}</h1>
    <p class="text-base">{t("legal.p1")}</p>
  </div>
  <div>
    <p class="mb-4">{t("legal.p2")}</p>
    
    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">{t("legal.subtitle1")}</h2>
    <p class="mb-6">{t("legal.p3")}</p>
    <ul class="list-inside list-disc space-y-4">
      <li>{t("legal.list1")}</li>
      <li>{t("legal.list2")}</li>
      <li>{t("legal.list3")}</li>
    </ul>
    
    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">{t("legal.subtitle2")}</h2>
    <p class="mb-4">{t("legal.p4")}</p>
    <ul class="list-inside list-disc space-y-4">
      <li>{t("legal.list4")}</li>
      <li>{t("legal.list5")}</li>
      <li>{t("legal.list6")}</li>
    </ul>

    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">{t("legal.subtitle3")}</h2>
    <p class="mb-4">{t("legal.p5")}</p>
    <ul class="list-inside list-disc space-y-4">
      <li>{t("legal.list7")}</li>
      <li>{t("legal.list8")}</li>
      <li>{t("legal.list9")}</li>
      <li>{t("legal.list10")}</li>
      <li>{t("legal.list11")}</li>
      <li>{t("legal.list12")}</li>
    </ul>

    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">{t("legal.subtitle4")}</h2>
    <p class="mb-4">{t("legal.p6")}</p>
    <ul class="list-inside list-disc space-y-4">
      <li>{t("legal.list13")}</li>
      <li>{t("legal.list14")}</li>
      <li>{t("legal.list15")}</li>
    </ul>

    <h2 class="mb-6 mt-12 text-xl font-medium sm:text-2xl">{t("legal.subtitle5")}</h2>
    <p class="mb-4">{t("legal.p7")}</p>
  </div>
</div>
</Layout>
