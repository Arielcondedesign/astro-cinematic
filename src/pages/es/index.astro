---
import Hero from '../../components/home/Hero.astro';
import About from '../../components/home/About.astro';
import Gallery from '../../components/home/Gallery.astro';
import Services from '../../components/home/Services.astro';
import Cta from '../../components/home/Cta.astro';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";
const currentLang = Astro.currentLocale || "es";
const t = useTranslations(currentLang as keyof typeof languageList);
---

<Layout title={t("home.title.tag")} description={t("home.meta.description")}>
  <Hero />
  <About />
  <h1 />
  <Gallery />
  <Services />
  <Cta />
</Layout>
