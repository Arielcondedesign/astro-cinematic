---
import { useI18n } from '../../utils/i18n';
const { lang } = Astro.props; // El idioma se pasa como prop desde la página padre
const i18n = useI18n(lang);

import { Image } from 'astro:assets';
import lidiaImage from '../../assets/lidia-martin-merino-directrice-documentaire.webp';
import bastianImage from '../../assets/bastian-sinse-post-production.webp';
import juanImage from '../../assets/juan-manuel-rosas-cameraman.webp';

const teamMembers = [
  {
    image: lidiaImage,
    name: t('films.team.members.0.name'),
    role: t('films.team.members.0.role'),
    description: t('films.team.members.0.description'),
    socials: {
      x: "#",
      linkedin: "#"
    }
  },
  {
    image: bastianImage,
    name: t('films.team.members.1.name'),
    role: t('films.team.members.1.role'),
    description: t('films.team.members.1.description'),
    socials: {
      x: "#",
      linkedin: "#"
    }
  },
  {
    image: juanImage,
    name: t('films.team.members.2.name'),
    role: t('films.team.members.2.role'),
    description: t('films.team.members.2.description'),
    socials: {
      x: "#",
      linkedin: "#"
    }
  }
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-12 sm:gap-16">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">{t('films.team.title')}</h2>
      <div class="grid gap-8 lg:grid-cols-3">
        {
          teamMembers.map((member) => (
            <div class="flex flex-col gap-4 sm:gap-6">
              <img
                class="h-64 w-full rounded-3xl object-cover"
                src={member.image}
                alt={member.name}
              />
              <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                  <h3 class="text-xl font-medium">{member.name}</h3>
                  <p class="text-primary-200/70">{member.role}</p>
                </div>
                <p class="text-base text-primary-200/70 sm:text-lg">
                  {member.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>