---
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";

const currentLang = Astro.currentLocale || "fr";
const t = useTranslations(currentLang as keyof typeof languageList);
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-8">
      <div class="flex flex-col gap-4 sm:gap-6">
        <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">{t("contact.form.h2")}</h2>
        <p class="text-primary-200/70 max-w-lg text-lg sm:text-xl">
          {t("contact.form.p")}
        </p>
      </div>
      <form action="https://api.web3forms.com/submit" method="POST" id="form" class="mt-3 flex flex-col gap-y-6" class="needs-validation" data-astro-reload novalidate>
        <input type="hidden" name="access_key" value="5f20568f-7d1a-45ff-b010-226a1b87874e" />
        
        <div>
          <label for="name" class="sr-only">{t("contact.label1")}</label>
          <input
            type="text"
            name="name"
            id="name"
            autocomplete="name"
            class="bg-primary-950 hover:ring-primary-400 focus:ring-primary-400 ring-primary-200/40 placeholder:text-primary-200/60 block w-full appearance-none rounded-md border-0 px-4 py-4 text-base ring-1 transition focus:outline-none focus:ring-2"
            placeholder={t("contact.placeholder1")}
          />
        </div>
        
        <!-- Projet input -->
        <div>
          <label for="project" class="sr-only">{t("contact.label2")}</label>
          <select
            name="project"
            id="project"
            class="hover:ring-primary-400 focus:ring-primary-400 bg-primary-950 ring-primary-200/40 block w-full appearance-none rounded-md border-0 px-4 py-4 text-base ring-1 transition focus:outline-none focus:ring-2"
          >
            <option value="" disabled selected>{t("contact.lebel2.option1")}</option>
            <option value="below-500">{t("contact.lebel2.option2")}</option>
            <option value="500-1000">{t("contact.lebel2.option3")}</option>
            <option value="1000-5000">{t("contact.lebel2.option4")}</option>
            <option value="5000-10000">{t("contact.lebel2.option5")}</option>
            <option value="above-10000">{t("contact.lebel2.option6")}</option>
          </select>
        </div>

        <!-- Email input -->
        <div>
          <label for="email" class="sr-only">{t("contact.label3")}</label>
          <input
            type="email"
            name="email"
            id="email"
            autocomplete="email"
            class="bg-primary-950 hover:ring-primary-400 focus:ring-primary-400 ring-primary-200/40 placeholder:text-primary-200/60 block w-full appearance-none rounded-md border-0 px-4 py-4 text-base ring-1 transition focus:outline-none focus:ring-2"
            placeholder={t("contact.placeholder3")}
          />
        </div>

        <!-- Message textarea -->
        <div>
          <label for="message" class="sr-only">{t("contact.label4")}</label>
          <textarea
            name="message"
            id="message"
            rows="3"
            class="bg-primary-950 hover:ring-primary-400 focus:ring-primary-400 ring-primary-200/40 placeholder:text-primary-200/60 block w-full appearance-none rounded-md border-0 px-4 py-4 text-base ring-1 transition focus:outline-none focus:ring-2"
            placeholder={t("contact.placeholder4")}></textarea>
        </div>
        
        <style class="tailwind">
          .privacy-link {
            text-decoration: underline;
            color: #C4B5FD;
            font-weight: bold;
          }
        
          .privacy-link:hover {
            color: #8B5CF6;
          }
        </style>
        
        <label>
          <input type="checkbox" id="privacyCheckbox" />
          {t("contact.label5")}{' '}
          <a href="/confidentialite/" target="_blank" rel="noopener noreferrer" class="privacy-link">
            {t("contact.label6")}
          </a>
        </label>

        <div>
          <button
            class="bg-transparent border hover:bg-primary-800/30 border-primary-400 focus-visible:outline-primary-400 text-primary-200 inline-flex items-center justify-center rounded-lg px-5 py-3 text-base font-medium transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            type="submit"
          >
          {t("contact.form.btn")}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>