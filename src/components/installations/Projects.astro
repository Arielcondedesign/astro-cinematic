---
import { Image } from 'astro:assets';
import { YouTube } from '@astro-community/astro-embed-youtube';
import posterImage from '../../assets/femmes-resistance-franquisme-memoire-poster.webp';
import posterBarral1 from '../../assets/expo-carral-web.webp';
import pressImage from '../../assets/Carcel-Centro-Creacion-Expo-Papillons_eladelantado.webp';


// Función para validar URLs
function isValidUrl(url) {
  try {
    new URL(url);
    return true;
  } catch (error) {
    return false;
  }
}

// Array de proyectos
const projects = [
  {
    videoUrl: "false",
    videoLink: "false",
    thumbnailUrl: posterBarral1,
    posterText: "Segovia - Paris 1937/2017",
    highlightedParagraph: "Barral Buitres y Roca",
    bgColor: "bg-fourtier-950"
  },
  {
    videoUrl: "false",
    videoLink: "https://www.youtube.com/watch?v=i4dSzxw8Iho",
    thumbnailUrl: posterImage,
    posterText: "Installation de femmes républicaines dans les prisons de Franco",
    highlightedParagraph: "PRISON POUR FEMMES, ESPAGNE L'HUMILATION \n Comme les gens \n \ L'IGNOMINIE  \n \Enquêtes psychologiques sur les femmes marxistes délinquantes \n DÉGRADATION \n en tant que mères : Dans les bras, les créatures sont mortes: mangées par la faim, les poux et la maladie \n LA MORTIFICATION \n En tant que femmes : La punition divine s'est faite chair dans notre corps\n LA DEPRECIATION \n En tant que citoyens : Nous sortons de prison et continuons à être méfiants",
    bgColor: "bg-primary-950"
  },
  {
  videoUrl: "false",
  videoLink: "false",
  thumbnailUrl: pressImage,
  posterText: "Communiqués de presse \"La palabra no dicha en La Cárcel.\"",
  highlightedParagraph: "L'installation Papillons, présentée à La Cárcel_Centro de Creación de Segovia, explore la répression subie par les femmes républicaines dans les prisons espagnoles de l'après-guerre. À travers des mots brodés, des objets quotidiens, des documents et un documentaire, l'exposition met en lumière leur double souffrance : en tant que femmes et républicaines. Les commissaires, Lidia Martín et Eugenia Navajo, s'inspirent d'une citation de María Zambrano pour évoquer la résilience et l'oppression systémique. L'exposition aborde également les théories eugénistes du psychiatre Vallejo-Nájera, qui déshumanisait ces femmes. Papillons rappelle une histoire douloureuse, essentielle pour comprendre les luttes passées et préserver la mémoire collective.",
  link: "https://eladelantado.com/segovia/la-palabra-no-dicha-en-la-carcel/",
  bgColor: "bg-fourtier-950",
  title: "Papillons : La mémoire des femmes républicaines",
  description: "L'exposition 'Papillons. La palabra no dicha' à La Cárcel_Segovia Centro de Creación révèle le vécu des prisonnières républicaines sous le franquisme. Disponible jusqu'au 9 mai 2021, elle présente des telas bordadas, objets d'époque, photos et un documentaire poignant. L'installation tire son nom d'une citation d'Antonio Vallejo-Nájera, psychiatre eugéniste du régime. Un 'deshomenaje' lui est dédié, exposant ses théories perverses sur le 'gène rouge'. L'exposition aborde des thèmes comme la menstruation, la faim, le travail forcé et les violences sexuelles, offrant un témoignage puissant de la résilience de ces femmes face à l'oppression[1]."
}
];
---
<section>
  {projects.map((project) => (
    <div 
      class={`min-h-screen flex flex-col justify-center items-center ${project.bgColor} py-16 px-4 sm:px-6 lg:px-8`}
    >
      <div class="flex flex-col items-center w-full max-w-4xl">
        {/* Imagen */}
        <div class="mb-8 w-full max-w-2xl">
          <Image 
            src={project.thumbnailUrl} 
            alt={project.posterText}
            class="w-full aspect-auto shadow-lg rounded-lg" 
            loading="lazy"
            decoding="async"
            width={800}
            height={600}
            quality="high"
          />
        </div>

        {/* Título y párrafo destacado */}
        <div class="text-center mb-8">
          <h2 class="text-2xl font-semibold text-primary-200 sm:text-3xl">
            {project.posterText}
          </h2>
          <p class="mt-4 text-primary-300">
  {project.highlightedParagraph.split('\n').map((line, index) => (
    <>
      {line.split(' ').map((word, i) => (
        <>
          {word}
          {i < line.split(' ').length - 1 ? ' ' : ''}
        </>
      ))}
      <br />
    </>
  ))}
</p>
        </div>

        {/* Video */}
        <div class="video-container mb-8 w-full max-w-2xl">
          {project.videoUrl !== "false" ? (
            <Vimeo id={project.videoUrl} class="aspect-video w-full rounded-lg shadow-lg" />
          ) : project.videoLink !== "false" ? (
            <div class="relative w-full">
              <div class="aspect-video bg-primary-950/10 rounded-lg shadow-lg">
                <YouTube 
                  id={project.videoLink.split('v=')[1].split('&')[0]} 
                  class="absolute inset-0 w-full h-full rounded-lg"
                  loading="lazy"
                  params="nocookie=true&rel=0&playsinline=1"
                  playlabel={`Regarder ${project.posterText}`}
                />
              </div>
              <a 
                href={project.videoLink}
                class="absolute inset-0 z-10 flex items-center justify-center bg-primary-950/10 hover:bg-primary-950/20 transition-colors group"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Voir la vidéo sur YouTube: ${project.posterText}`}
              >
                <div class="p-4 rounded-full bg-primary-400/10 group-hover:bg-primary-400/20 transition-colors">
                  <span class="sr-only">Voir sur YouTube: {project.posterText}</span>
                  <svg 
                    class="w-12 h-12 text-primary-200" 
                    viewBox="0 0 24 24" 
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </a>
            </div>
          ) : null}
        </div>

        {/* Enlace de prensa (si existe) */}
        {project.link && isValidUrl(project.link) && (
          <div class="mt-8">
            <a 
              href={project.link} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-primary-200 hover:text-primary-300 underline"
            >
              En savoir plus
            </a>
          </div>
        )}

        {/* Título y descripción del proyecto */}
        <div class="mt-8 w-full max-w-2xl text-center">
          <h2 class="text-2xl font-semibold text-primary-200 sm:text-3xl">
            {project.title}
          </h2>
          <div class="mt-4 text-primary-300">
            <p>{project.description}</p>
          </div>
        </div>
      </div>
    </div>
  ))}
</section>