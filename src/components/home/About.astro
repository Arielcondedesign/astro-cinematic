---
import { useI18n } from '../../utils/i18n';
const { lang } = Astro.props; // El idioma se pasa como prop desde la página padre
const i18n = useI18n(lang);
import LocalizedLink from '../shared/LocalizedLink.astro';

---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-8">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">{i18n.t('about.title')}</h2>
      <div class="flex flex-col items-start gap-8 sm:gap-10 lg:col-span-2">
        <p class="text-primary-200/70 text-base sm:text-lg">
          {i18n.t('about.subtitle')}
        </p>
        <LocalizedLink 
          href="/apropos"
          lang={lang}
          class="bg-primary-500 hover:bg-primary-400 focus-visible:outline-primary-500 inline-flex items-center justify-center rounded-full border border-transparent px-5 py-3 text-base font-medium text-white transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">
          {i18n.t('about.button')}
        </LocalizedLink>
      </div>
    </div>
  </div>
</section>