---
import FilmsImage from '../images/FilmsImage.astro';    
import InstallationsImage from '../images/InstallationsImage.astro';
---

<section class="py-16 sm:py-20">
    <div class="container mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-primary-400/10 shadow-lg rounded-lg overflow-hidden transform transition duration-300 hover:scale-105">
                <FilmsImage class="w-full h-48 object-cover" />
                <div class="p-6">
                    <h2 class="text-2xl font-bold mb-2">Films</h2>
                    <p class="text-priamry-700 mb-4">Explorez notre collection de films marquants qui défient les récits officiels et donnent voix aux histoires silenciées.</p>
                    <a href="/films" class="bg-transparent border hover:bg-primary-800/30 border-primary-400 focus-visible:outline-primary-400 text-primary-200 inline-flex items-center justify-center rounded-lg px-5 py-3 text-base font-medium transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">Explorer nos films</a>    
                </div>
            </div>
            
            <div class="bg-primary-400/10 shadow-lg rounded-lg overflow-hidden transform transition duration-300 hover:scale-105">
                <InstallationsImage class="w-full h-48 object-cover" />
                <div class="p-6">
                    <h2 class="text-2xl font-bold mb-2">Installations</h2>
                    <p class="text-priamry-700 mb-4">Découvrez nos installations artistiques qui transforment chaque espace.</p>
                    <a href="/installations" class="bg-fourtier-900 hover:bg-fourtier-700 focus-visible:outline-primary-400 text-primary-100 inline-flex items-center justify-center rounded-lg border border-transparent px-5 py-3 text-base font-medium text-primary-100 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">Parcourir nos installations</a>    
                </div>
            </div>
        </div>
    </div>      
</section>