---
import HeroImage from '../images/HeroImage.astro';
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";

const currentLang = Astro.currentLocale || "fr";
const t = useTranslations(currentLang as keyof typeof languageList);
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-16">
      <div class="flex flex-col items-start gap-8 sm:gap-10">
        <div class="flex max-w-xl flex-col items-start gap-4 sm:gap-6">
          <h1 class="text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl">
            {t("home.hero.title")}
          </h1>
          <p class="text-primary-200/70 text-lg sm:text-xl">
            {t("home.hero.p")}
          </p>
        </div>
      </div>
      <HeroImage class="h-auto w-full rounded-3xl" />
    </div>
  </div>
</section>