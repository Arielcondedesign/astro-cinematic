---
import { useTranslations } from '../../i18n/utils';
import { languageList } from "../../i18n/ui";

const currentLang = Astro.currentLocale || "fr";
const t = useTranslations(currentLang as keyof typeof languageList);
---

<section class="bg-cover bg-center py-16 sm:py-20" style="background-image: url('/assets/gardien-feu-chien-noir.webp');">
  <div class="bg-black bg-opacity-70 mx-auto max-w-2xl px-4 text-center sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-4 sm:gap-6">
      <h1 class="text-4xl font-medium tracking-tight sm:text-5xl lg:text-6xl">{t("longs.head.h1")}</h1>
    </div>
  </div>
</section>