---
import { useI18n } from '../../utils/i18n';
import { Vimeo } from '@astro-community/astro-embed-vimeo';
import { YouTube } from '@astro-community/astro-embed-youtube';

const { lang } = Astro.props;
const i18n = useI18n(lang);

// Props específicas que pueden venir del padre
const { 
  title, 
  description, 
  year, 
  category 
} = Astro.props;

// Los proyectos deberían venir de los archivos de traducción
const projects = [
  {
    title: i18n.t('longs.projects.preproduction.title'),
    description: i18n.t('longs.projects.preproduction.description'),
    videoUrl: "https://vimeo.com/835888678",
    videoLink: false,
    year: "2025",
    bgColor: "bg-primary-950"
  },
  {
    title: i18n.t('longs.projects.memorias.title'),
    description: i18n.t('longs.projects.memorias.description'),
    videoUrl: "https://vimeo.com/535572445",
    videoLink: false,
    year: "2009",
    bgColor: "bg-secondary-950"
  },
  {
    title: i18n.t('longs.projects.avefria.title'),
    description: i18n.t('longs.projects.avefria.description'),
    videoUrl: false,
    videoLink: "https://www.youtube.com/watch?v=h8q49pSEIxs",
    year: "2012",
    bgColor: "bg-primary-950"
  },
  {
    title: i18n.t('longs.projects.godot.title'),
    description: i18n.t('longs.projects.godot.description'),
    videoUrl: "https://vimeo.com/535572447",
    year: "2014",
    bgColor: "bg-secondary-950"
  },
  {
    title: i18n.t('longs.projects.agapito.title'),
    description: i18n.t('longs.projects.agapito.description'),
    videoUrl: "https://vimeo.com/508785843",
    year: "2019",
    bgColor: "bg-primary-950"
  }
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:max-w-none">
      <div class="space-y-16">
        {projects.map((project) => (
          <div class={`${project.bgColor} rounded-2xl p-8`}>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">
              {project.title}
            </h3>
            <p class="text-lg text-gray-700 mb-6">
              {project.description}
            </p>
            <div class="aspect-w-16 aspect-h-9 rounded-lg overflow-hidden">
              {project.videoUrl ? (
                <Vimeo
                  id={project.videoUrl.split('/').pop()}
                  class="w-full h-full"
                />
              ) : project.videoLink ? (
                <YouTube
                  id={new URL(project.videoLink).searchParams.get('v')}
                  class="w-full h-full"
                />
              ) : null}
            </div>
            <div class="mt-4 text-sm text-gray-700">
              {project.year}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>