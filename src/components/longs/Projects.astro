---
import { Vimeo } from '@astro-community/astro-embed-vimeo';
import { YouTube } from '@astro-community/astro-embed-youtube';

import { useTranslations } from '../../i18n/utils';
import { languageList } from "../../i18n/ui";

const currentLang = Astro.currentLocale || "fr";
const t = useTranslations(currentLang as keyof typeof languageList);

const { 
title, 
description, 
year,  
} = Astro.props;

const projects = [
{
    title: t("longs.projects.title1"),
    description: "Cerdos, la guerre n'est pas finie.",
    videoUrl: "https://vimeo.com/835888678",
    videoLink: "false",
    thumbnailUrl: "url-de-votre-image-1",
    year: "2025",
    bgColor: "bg-primary-950"
},
{
    title: "Memorias de la Esperanza",
    description: t("longs.projects.details.p2"),
    videoUrl: "https://vimeo.com/535572445",
    videoLink: "false",
    thumbnailUrl: "url-de-votre-image-1",
    year: "2009",
    bgColor: "bg-secondary-950"
},
{
    title: "El retorno del avefría",
    description: t("longs.projects.details.p3"),
    videoUrl: "false",
    videoLink: "https://www.youtube.com/watch?v=h8q49pSEIxs",
    thumbnailUrl: "url-de-votre-image-2",
    year: "2012",
    bgColor: "bg-priamry-950"
},
{
    title: "Esperando a Godot",
    description: t("longs.projects.details.p4"),
    videoUrl: "https://vimeo.com/535572447",
    thumbnailUrl: "url-de-votre-image-3",
    year: "2014",
    bgColor: "bg-secondary-950"
},
{
    title: "Trailer Agapito Marazuela, La statue brisée",
    description: t("longs.projects.details.p5"),
    videoUrl: "https://vimeo.com/508785843",
    thumbnailUrl: "url-de-votre-image-3",
    year: "2019",
    bgColor: "bg-primary-950"
}
];
---
<section>
    {projects.map((project) => (
      <div class={`w-full pt-16 pb-16 ${project.bgColor}`}>
        <div class="grid grid-cols-1 md:grid-cols-4 md:items-center md:gap-8">
          <div class="md:col-span-3">
            <div class="video-container">
              {project.videoUrl !== "false" ? (
                <Vimeo id={project.videoUrl} class="aspect-video" />
              ) : project.videoLink !== "false" ? (
                <YouTube id={project.videoLink.split('v=')[1].split('&')[0]} class="aspect-video" />
              ) : null}
            </div>
          </div>
  
          <div class="md:col-span-1 pt-4 lg:pt-4 sm:pt-8 pl-4 lg:pl-0 sm:pl-8">
            <div class="max-w-lg md:max-w-none">
              <h2 class="text-2xl font-semibold text-priamry-900 sm:text-3xl">
                {project.title}
              </h2>
  
              <div class="mt-4 text-priamry-700">
                <p>{project.description}</p>
                
                <div class="project-metadata mt-4">
                  <h3 class="font-bold">{t("projects.details.h3")}</h3>
                  <ul class="list-disc pl-5">
                    <li>{t("projects.details.year")}: {project.year}</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
</section>