---
import MissionImage1 from '../images/MissionImage1.astro';
import MissionImage2 from '../images/MissionImage2.astro';
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";

const currentLang = Astro.currentLocale || "fr";
const t = useTranslations(currentLang as keyof typeof languageList);
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <div class="flex flex-col gap-10">
        <MissionImage1 class="mx-auto h-cover w-full max-w-xl rounded-3xl" />
        <MissionImage2 class="mx-auto h-auto w-full max-w-xl rounded-3xl" />
      </div>
      <div class="flex flex-col gap-10">
        <!-- Mission description -->
        <div class="space-y-8 sm:space-y-12">
          <div class="space-y-6">
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              {t("about.mission.p")}
            </p>
          </div>
        </div>
        <div class="space-y-8 sm:space-y-12">
          <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">{t("about.mission.h2")}</h2>
          <div class="space-y-6">
            <p class="text-primary-950/70 dark:text-primary-200/70 text-base sm:text-lg">
              {t("about.mission.history.p")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>