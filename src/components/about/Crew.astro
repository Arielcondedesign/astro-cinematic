---
import { Image } from 'astro:assets';
import lidiaImage from '../../assets/lidia-martin-merino-directrice-documentaire.webp';
import africaImage from '../../assets/bayon-africa-scenographe.webp';
import bastianImage from '../../assets/bastian-sinse-post-production.webp';
import theoImage from '../../assets/theo-monteur-video.webp';
import juanImage from '../../assets/juan-manuel-rosas-camera.webp';
import eduImage from '../../assets/eduardo-argentinien-monteur-video.webp';
import { useTranslations } from "../../i18n/utils";
import { languageList } from "../../i18n/ui";

const currentLang = Astro.currentLocale || "fr";
const t = useTranslations(currentLang as keyof typeof languageList);

const teamMembers = [
{
    image: lidiaImage,
    name: "Lidia Martín Merino",
    role: t("about.crew.tm.role1")
  },
  {
    image: bastianImage,
    name: "Bastian Sinsé",
    role: t("about.crew.tm.role2")
  },
  {
    image: juanImage,
    name: "Juan Manuel Rosas",
    role: t("about.crew.tm.role3")
  },
  {
    image: theoImage,
    name: "Théo Heldmann",
    role: t("about.crew.tm.role4")
  },
  {
    image: africaImage,
    name: "Africa Bayón",
    role: t("about.crew.tm.role5")
  },
  {
    image: eduImage,
    name: "Eduardo López, Argentina",
    role: t("about.crew.tm.role6")
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="sm:space-8 space-y-12">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">{t("about.crew.h2")}</h2>
      <ul role="list" class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          teamMembers.map(({ name, image, role }) => (
            <li class="border-primary-900/10 dark:border-primary-300/10 rounded-3xl border px-6 py-8">
              <div class="space-y-6">
                <Image src={image} alt={name} class="mx-auto h-auto w-16 rounded-full" />
                <div class="text-center">
                  <h3 class="text-lg font-medium">{name}</h3>
                  <p class="text-primary-950/70 dark:text-primary-200/70 text-base">{role}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>